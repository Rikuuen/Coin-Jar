# Local app. Never expose the API publicly without adding user authentication.
PORT=4318
COINJAR_DB=.data/coinjar-php.sqlite
# Walrus dashboard account and delegate. Keep these server-side.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=coinjar-php
# Tatum read-only Sui balance. No transactions.
TATUM_API_KEY=
SUI_NETWORK=mainnet
