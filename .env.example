# Local app. Never expose the API publicly without adding user authentication.
PORT=4318
COINJAR_DB=.data/coinjar-php.sqlite
# Walrus dashboard account and delegate. Keep these server-side.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=coinjar-php
# Tatum read-only Sui balance. No transactions.
TATUM_API_KEY=
SUI_NETWORK=mainnet

# Hosted tracking uses a separate PostgreSQL database and Neon Auth project.
# The hosted build must be explicitly enabled; it does not execute wallet transfers.
VITE_COINJAR_HOSTED=false
NEON_AUTH_BASE_URL=
# Random server-side secret of at least 32 characters, never sent to the browser.
NEON_AUTH_COOKIE_SECRET=
COINJAR_ORIGIN=
# Use a restricted role and a PostgreSQL URL with sslmode=verify-full.
DATABASE_URL=
