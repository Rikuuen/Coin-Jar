{
  "name": "coinjar-total-recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx --env-file-if-exists=.env server/index.ts",
    "demo": "node scripts/demo.mjs",
    "legacy": "node scripts/legacy.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.js",
    "test:browser": "playwright test",
    "start:hosted": "tsx hosted/server.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@grpc/grpc-js": "1.14.7",
    "@mysten-incubation/memwal": "0.1.12",
    "@mysten/dapp-kit-react": "2.1.43",
    "@mysten/sui": "2.38.0",
    "@neon/auth": "0.8.2",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "@vercel/blob": "2.8.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@vercel/cli-config": "0.3.7",
    "@mysten-incubation/memwal": {
      "@mysten/seal": "1.5.2"
    },
    "@mysten/dapp-kit-core": "1.6.41",
    "@mysten/slush-wallet": "1.3.6",
    "@mysten/wallet-standard": "0.21.36",
    "@neon/auth": {
      "better-auth": "1.7.12",
      "@better-auth/core": "1.7.12",
      "@better-auth/oauth-provider": "1.7.12",
      "better-call": "1.4.4"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
